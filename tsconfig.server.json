{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["src/server/**/*", "src/cli.ts", "src/cli-query.ts", "src/mcp-server.ts", "src/recovery/**/*"]
}
